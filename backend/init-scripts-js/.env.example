# ClickHouse connection for the init scripts.
# Copy this file to .env and fill in your values.

CLICKHOUSE_URL="https://clickhouse.example.com:8443"
CLICKHOUSE_USER="default"
CLICKHOUSE_PASS=""
CLICKHOUSE_DATABASE="kseer"

# Topology to provision:
#   distributed - ReplicatedMergeTree per shard + a Distributed table, created
#                 ON CLUSTER. Requires a ClickHouse cluster with Keeper.
#   single      - one plain MergeTree table on a single node. CLICKHOUSE_CLUSTER
#                 is ignored.
# Either way the agent writes to, and the UI reads from, kubernetes_events.
CLICKHOUSE_MODE="distributed"

# Cluster name from system.clusters. Used in distributed mode only.
CLICKHOUSE_CLUSTER="default"

# Set to "true" to drop existing tables before recreating them.
DROP_EXISTING="false"
