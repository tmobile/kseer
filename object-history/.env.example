# ClickHouse target for the Object History UI.
# Copy this file to .env (and/or .env.local) and fill in your values.
#
# The table name is the same whether the backend was provisioned in
# distributed or single-instance mode.

# Database and table the UI reads from.
VITE_CLICKHOUSE_DATABASE=kseer
VITE_CLICKHOUSE_TABLE=kubernetes_events

CLICKHOUSE_DATABASE="kseer"
CLICKHOUSE_TABLE="kubernetes_events"

# Optional: Azure AD / MSAL auth for the authz proxy.
# Set VITE_AZURE_ENABLED=true and provide your own tenant/client IDs.
VITE_AZURE_ENABLED=false
VITE_AZURE_TENANT_ID=your-azure-tenant-id
VITE_AZURE_CLIENT_ID=your-azure-client-id
VITE_AZURE_USE_ID_TOKEN=false
